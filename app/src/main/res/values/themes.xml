<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme enforcing light mode only and disabling dark theme override on Samsung One UI 7 / Android 15 -->
    <style name="Theme.FunctionalSpice" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_alabaster</item>
        <item name="android:statusBarColor">@color/bg_alabaster</item>
        <item name="android:navigationBarColor">@color/bg_alabaster</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>

